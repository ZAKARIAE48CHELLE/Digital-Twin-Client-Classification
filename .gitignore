# pyenv
#   For a library or package, you might want to share your .python-version.
#   For an app, this is usually fine to prevent git from tracking it.
# .python-version

# pipenv
#   According to pypa/pipenv#598, it is recommended to include Pipfile.lock in version control.
#   However, in case of collaboration, if delegates have different platforms, you may choose to ignore it.
#Locking development/production dependencies is key to reproducibility, so keeping it is usually better.
# Pipfile.lock

# poetry
#   Similar to Pipfile.lock, poetry.lock is generally recommended to be tracked.
# poetry.lock

# pdm
#   Similar to Pipfile.lock, pdm.lock is generally recommended to be tracked.
# pdm.lock

